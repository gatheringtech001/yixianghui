{
  "meta": {
    "title": "智享居管理系统 API Catalog",
    "version": "2026-05-28",
    "baseUrl": "/api",
    "fullBaseUrlExample": "http://localhost:8080/api",
    "sourcePackage": "com.ruoyi.web.controller.app",
    "swaggerUi": "/api/swagger-ui/index.html",
    "authHeader": "Authorization",
    "authFormat": "Bearer {jwt_token}"
  },
  "conventions": {
    "listResponse": "TableDataInfo { total, rows, code, msg }",
    "actionResponse": "AjaxResult { code, msg, data? }",
    "paginationQuery": ["pageNum", "pageSize", "orderByColumn", "isAsc"],
    "adminCrudPattern": {
      "list": { "method": "GET", "pathSuffix": "/list", "permSuffix": ":list" },
      "export": { "method": "POST", "pathSuffix": "/export", "permSuffix": ":export" },
      "get": { "method": "GET", "pathSuffix": "/{id}", "permSuffix": ":query" },
      "add": { "method": "POST", "pathSuffix": "", "permSuffix": ":add" },
      "edit": { "method": "PUT", "pathSuffix": "", "permSuffix": ":edit" },
      "remove": { "method": "DELETE", "pathSuffix": "/{ids}", "permSuffix": ":remove" }
    }
  },
