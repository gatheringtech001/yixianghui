<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AppGoodsCouponMapper">
    
    <resultMap type="AppGoodsCoupon" id="AppGoodsCouponResult">
        <result property="couponId"    column="coupon_id"    />
        <result property="userId"    column="user_id"    />
        <result property="categoryId"    column="category_id"    />
        <result property="goodsId"    column="goods_id"    />
        <result property="couponName"    column="coupon_name"    />
        <result property="couponContent"    column="coupon_content"    />
        <result property="couponType"    column="coupon_type"    />
        <result property="minPrice"    column="min_price"    />
        <result property="discountType"    column="discount_type"    />
        <result property="discountPrice"    column="discount_price"    />
        <result property="countPerOrder"    column="count_per_order"    />
        <result property="couponTotal"    column="coupon_total"    />
        <result property="countPerUser"    column="count_per_user"    />
        <result property="couponGotCount"    column="coupon_got_count"    />
        <result property="couponUsedCount"    column="coupon_used_count"    />
        <result property="enableStartTime"    column="enable_start_time"    />
        <result property="enableEndTime"    column="enable_end_time"    />
        <result property="getMethod"    column="get_method"    />
        <result property="channelCode" column="channel_code" />
        <result property="sourceAppId" column="source_app_id" />
        <result property="popupTitle" column="popup_title" />
        <result property="visitCount" column="visit_count" />
        <result property="orderCount" column="order_count" />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="status"    column="status"    />
    </resultMap>

    <sql id="selectAppGoodsCouponVo">
        select c.*,
          (select count(*) from app_distribution_visit v where v.channel_code = c.channel_code) visit_count,
          (select count(*) from app_goods_order o where o.distribution_channel_code = c.channel_code) order_count
        from app_goods_coupon c
    </sql>

    <select id="selectAppGoodsCouponList" parameterType="AppGoodsCoupon" resultMap="AppGoodsCouponResult">
        <include refid="selectAppGoodsCouponVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="categoryId != null "> and category_id = #{categoryId}</if>
            <if test="goodsId != null "> and goods_id = #{goodsId}</if>
            <if test="couponName != null  and couponName != ''"> and coupon_name like concat('%', #{couponName}, '%')</if>
            <if test="couponContent != null  and couponContent != ''"> and coupon_content = #{couponContent}</if>
            <if test="couponType != null  and couponType != ''"> and coupon_type = #{couponType}</if>
            <if test="minPrice != null "> and min_price = #{minPrice}</if>
            <if test="discountType != null  and discountType != ''"> and discount_type = #{discountType}</if>
            <if test="discountPrice != null "> and discount_price = #{discountPrice}</if>
            <if test="countPerOrder != null "> and count_per_order = #{countPerOrder}</if>
            <if test="couponTotal != null "> and coupon_total = #{couponTotal}</if>
            <if test="countPerUser != null "> and count_per_user = #{countPerUser}</if>
            <if test="couponGotCount != null "> and coupon_got_count = #{couponGotCount}</if>
            <if test="couponUsedCount != null "> and coupon_used_count = #{couponUsedCount}</if>
            <if test="enableStartTime != null "> and enable_start_time = #{enableStartTime}</if>
            <if test="enableEndTime != null "> and enable_end_time = #{enableEndTime}</if>
            <if test="getMethod != null  and getMethod != ''"> and get_method = #{getMethod}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>

    <select id="selectByChannelCodeForUpdate" resultMap="AppGoodsCouponResult">
        select * from app_goods_coupon where channel_code = #{channelCode} for update
    </select>

    <update id="incrementGotCount">
        update app_goods_coupon set coupon_got_count = coupon_got_count + 1 where coupon_id = #{couponId}
    </update>

    <update id="incrementUsedCount">
        update app_goods_coupon set coupon_used_count = coupon_used_count + 1 where coupon_id = #{couponId}
    </update>

    <update id="decrementUsedCount">
        update app_goods_coupon set coupon_used_count = greatest(coupon_used_count - 1, 0)
        where coupon_id = #{couponId}
    </update>
    
    <select id="selectAppGoodsCouponByCouponId" parameterType="Long" resultMap="AppGoodsCouponResult">
        <include refid="selectAppGoodsCouponVo"/>
        where coupon_id = #{couponId}
    </select>

    <insert id="insertAppGoodsCoupon" parameterType="AppGoodsCoupon" useGeneratedKeys="true" keyProperty="couponId">
        insert into app_goods_coupon
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="categoryId != null">category_id,</if>
            <if test="goodsId != null">goods_id,</if>
            <if test="couponName != null">coupon_name,</if>
            <if test="couponContent != null">coupon_content,</if>
            <if test="couponType != null and couponType != ''">coupon_type,</if>
            <if test="minPrice != null">min_price,</if>
            <if test="discountType != null">discount_type,</if>
            <if test="discountPrice != null">discount_price,</if>
            <if test="countPerOrder != null">count_per_order,</if>
            <if test="couponTotal != null">coupon_total,</if>
            <if test="countPerUser != null">count_per_user,</if>
            <if test="couponGotCount != null">coupon_got_count,</if>
            <if test="couponUsedCount != null">coupon_used_count,</if>
            <if test="enableStartTime != null">enable_start_time,</if>
            <if test="enableEndTime != null">enable_end_time,</if>
            <if test="getMethod != null and getMethod != ''">get_method,</if>
            <if test="channelCode != null and channelCode != ''">channel_code,</if>
            <if test="sourceAppId != null and sourceAppId != ''">source_app_id,</if>
            <if test="popupTitle != null and popupTitle != ''">popup_title,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="status != null">status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="categoryId != null">#{categoryId},</if>
            <if test="goodsId != null">#{goodsId},</if>
            <if test="couponName != null">#{couponName},</if>
            <if test="couponContent != null">#{couponContent},</if>
            <if test="couponType != null and couponType != ''">#{couponType},</if>
            <if test="minPrice != null">#{minPrice},</if>
            <if test="discountType != null">#{discountType},</if>
            <if test="discountPrice != null">#{discountPrice},</if>
            <if test="countPerOrder != null">#{countPerOrder},</if>
            <if test="couponTotal != null">#{couponTotal},</if>
            <if test="countPerUser != null">#{countPerUser},</if>
            <if test="couponGotCount != null">#{couponGotCount},</if>
            <if test="couponUsedCount != null">#{couponUsedCount},</if>
            <if test="enableStartTime != null">#{enableStartTime},</if>
            <if test="enableEndTime != null">#{enableEndTime},</if>
            <if test="getMethod != null and getMethod != ''">#{getMethod},</if>
            <if test="channelCode != null and channelCode != ''">#{channelCode},</if>
            <if test="sourceAppId != null and sourceAppId != ''">#{sourceAppId},</if>
            <if test="popupTitle != null and popupTitle != ''">#{popupTitle},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="status != null">#{status},</if>
         </trim>
    </insert>

    <update id="updateAppGoodsCoupon" parameterType="AppGoodsCoupon">
        update app_goods_coupon
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="goodsId != null">goods_id = #{goodsId},</if>
            <if test="couponName != null">coupon_name = #{couponName},</if>
            <if test="couponContent != null">coupon_content = #{couponContent},</if>
            <if test="couponType != null and couponType != ''">coupon_type = #{couponType},</if>
            <if test="minPrice != null">min_price = #{minPrice},</if>
            <if test="discountType != null">discount_type = #{discountType},</if>
            <if test="discountPrice != null">discount_price = #{discountPrice},</if>
            <if test="countPerOrder != null">count_per_order = #{countPerOrder},</if>
            <if test="couponTotal != null">coupon_total = #{couponTotal},</if>
            <if test="countPerUser != null">count_per_user = #{countPerUser},</if>
            <if test="couponGotCount != null">coupon_got_count = #{couponGotCount},</if>
            <if test="couponUsedCount != null">coupon_used_count = #{couponUsedCount},</if>
            <if test="enableStartTime != null">enable_start_time = #{enableStartTime},</if>
            <if test="enableEndTime != null">enable_end_time = #{enableEndTime},</if>
            <if test="getMethod != null and getMethod != ''">get_method = #{getMethod},</if>
            <if test="channelCode != null">channel_code = #{channelCode},</if>
            <if test="sourceAppId != null">source_app_id = #{sourceAppId},</if>
            <if test="popupTitle != null">popup_title = #{popupTitle},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where coupon_id = #{couponId}
    </update>

    <delete id="deleteAppGoodsCouponByCouponId" parameterType="Long">
        delete from app_goods_coupon where coupon_id = #{couponId}
    </delete>

    <delete id="deleteAppGoodsCouponByCouponIds" parameterType="String">
        delete from app_goods_coupon where coupon_id in 
        <foreach item="couponId" collection="array" open="(" separator="," close=")">
            #{couponId}
        </foreach>
    </delete>
</mapper>
