<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AppUserChargeMapper">
    
    <resultMap type="AppUserCharge" id="AppUserChargeResult">
        <result property="chargeId"    column="charge_id"    />
        <result property="orderNo"    column="order_no"    />
        <result property="userId"    column="user_id"    />
        <result property="payMethod"    column="pay_method"    />
        <result property="payNo"    column="pay_no"    />
        <result property="money"    column="money"    />
        <result property="isAward"    column="is_award"    />
        <result property="createTime"    column="create_time"    />
        <result property="status"    column="status"    />
    </resultMap>

    <sql id="selectAppUserChargeVo">
        select charge_id, order_no, user_id, pay_method, pay_no, money, is_award, create_time, status from app_user_charge
    </sql>

    <select id="selectAppUserChargeList" parameterType="AppUserCharge" resultMap="AppUserChargeResult">
        <include refid="selectAppUserChargeVo"/>
        <where>  
            <if test="orderNo != null  and orderNo != ''"> and order_no = #{orderNo}</if>
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="payMethod != null  and payMethod != ''"> and pay_method = #{payMethod}</if>
            <if test="payNo != null  and payNo != ''"> and pay_no = #{payNo}</if>
            <if test="money != null "> and money = #{money}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectAppUserChargeByChargeId" parameterType="Long" resultMap="AppUserChargeResult">
        <include refid="selectAppUserChargeVo"/>
        where charge_id = #{chargeId}
    </select>

    <insert id="insertAppUserCharge" parameterType="AppUserCharge" useGeneratedKeys="true" keyProperty="chargeId">
        insert into app_user_charge
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderNo != null">order_no,</if>
            <if test="userId != null">user_id,</if>
            <if test="payMethod != null">pay_method,</if>
            <if test="payNo != null">pay_no,</if>
            <if test="money != null">money,</if>
            <if test="isAward != null">is_award,</if>
            <if test="createTime != null">create_time,</if>
            <if test="status != null">status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderNo != null">#{orderNo},</if>
            <if test="userId != null">#{userId},</if>
            <if test="payMethod != null">#{payMethod},</if>
            <if test="payNo != null">#{payNo},</if>
            <if test="money != null">#{money},</if>
            <if test="isAward != null">#{isAward},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="status != null">#{status},</if>
         </trim>
    </insert>

    <update id="updateAppUserCharge" parameterType="AppUserCharge">
        update app_user_charge
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="payMethod != null">pay_method = #{payMethod},</if>
            <if test="payNo != null">pay_no = #{payNo},</if>
            <if test="money != null">money = #{money},</if>
            <if test="isAward != null">is_award = #{isAward},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where charge_id = #{chargeId}
    </update>

    <delete id="deleteAppUserChargeByChargeId" parameterType="Long">
        delete from app_user_charge where charge_id = #{chargeId}
    </delete>

    <delete id="deleteAppUserChargeByChargeIds" parameterType="String">
        delete from app_user_charge where charge_id in 
        <foreach item="chargeId" collection="array" open="(" separator="," close=")">
            #{chargeId}
        </foreach>
    </delete>
</mapper>