<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AppCustomerIncomeMapper">
    
    <resultMap type="AppCustomerIncome" id="AppCustomerIncomeResult">
        <result property="incomeId"    column="income_id"    />
        <result property="userId"    column="user_id"    />
        <result property="productName"    column="product_name"    />
        <result property="incomeNo"    column="income_no"    />
        <result property="deptId"    column="dept_id"    />
        <result property="chargeAmount"    column="charge_amount"    />
        <result property="purchaseAmount"    column="purchase_amount"    />
        <result property="balance"    column="balance"    />
        <result property="score"    column="score"    />
        <result property="tradeDate"    column="trade_date"    />
        <result property="settlement"    column="settlement"    />
        <result property="companyIncome"    column="company_income"    />
        <result property="consultantIncome"    column="consultant_income"    />
        <result property="productType"    column="product_type"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="remark"    column="remark"    />
        <result property="consultantId"    column="consultant_id"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectAppCustomerIncomeVo">
        select income_id, user_id, product_name, income_no, dept_id, charge_amount, purchase_amount, balance, score, trade_date, settlement, company_income, consultant_income, product_type, supplier_id, remark, consultant_id, create_by, create_time, update_by, update_time from app_customer_income
    </sql>

    <select id="selectAppCustomerIncomeList" parameterType="AppCustomerIncome" resultMap="AppCustomerIncomeResult">
        <include refid="selectAppCustomerIncomeVo"/>
        <where>  
            <if test="userId != null "> and user_id = #{userId}</if>
            <if test="productName != null  and productName != ''"> and product_name like concat('%', #{productName}, '%')</if>
            <if test="incomeNo != null  and incomeNo != ''"> and income_no = #{incomeNo}</if>
            <if test="deptId != null "> and dept_id = #{deptId}</if>
            <if test="chargeAmount != null "> and charge_amount = #{chargeAmount}</if>
            <if test="purchaseAmount != null "> and purchase_amount = #{purchaseAmount}</if>
            <if test="balance != null "> and balance = #{balance}</if>
            <if test="score != null "> and score = #{score}</if>
            <if test="tradeDate != null "> and trade_date = #{tradeDate}</if>
            <if test="settlement != null "> and settlement = #{settlement}</if>
            <if test="companyIncome != null "> and company_income = #{companyIncome}</if>
            <if test="consultantIncome != null "> and consultant_income = #{consultantIncome}</if>
            <if test="productType != null  and productType != ''"> and product_type = #{productType}</if>
            <if test="supplierId != null "> and supplier_id = #{supplierId}</if>
            <if test="consultantId != null "> and consultant_id = #{consultantId}</if>
        </where>
        order by trade_date desc, income_id desc
    </select>

    <select id="sumConsultantIncome" resultType="java.math.BigDecimal">
        select COALESCE(SUM(consultant_income), 0)
        from app_customer_income
        where consultant_id = #{consultantId}
        <if test="settlement != null"> and settlement = #{settlement}</if>
    </select>
    
    <select id="selectAppCustomerIncomeByIncomeId" parameterType="Long" resultMap="AppCustomerIncomeResult">
        <include refid="selectAppCustomerIncomeVo"/>
        where income_id = #{incomeId}
    </select>

    <insert id="insertAppCustomerIncome" parameterType="AppCustomerIncome" useGeneratedKeys="true" keyProperty="incomeId">
        insert into app_customer_income
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="productName != null">product_name,</if>
            <if test="incomeNo != null">income_no,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="chargeAmount != null">charge_amount,</if>
            <if test="purchaseAmount != null">purchase_amount,</if>
            <if test="balance != null">balance,</if>
            <if test="score != null">score,</if>
            <if test="tradeDate != null">trade_date,</if>
            <if test="settlement != null">settlement,</if>
            <if test="companyIncome != null">company_income,</if>
            <if test="consultantIncome != null">consultant_income,</if>
            <if test="productType != null">product_type,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="remark != null">remark,</if>
            <if test="consultantId != null">consultant_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="productName != null">#{productName},</if>
            <if test="incomeNo != null">#{incomeNo},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="chargeAmount != null">#{chargeAmount},</if>
            <if test="purchaseAmount != null">#{purchaseAmount},</if>
            <if test="balance != null">#{balance},</if>
            <if test="score != null">#{score},</if>
            <if test="tradeDate != null">#{tradeDate},</if>
            <if test="settlement != null">#{settlement},</if>
            <if test="companyIncome != null">#{companyIncome},</if>
            <if test="consultantIncome != null">#{consultantIncome},</if>
            <if test="productType != null">#{productType},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="remark != null">#{remark},</if>
            <if test="consultantId != null">#{consultantId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateAppCustomerIncome" parameterType="AppCustomerIncome">
        update app_customer_income
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="productName != null">product_name = #{productName},</if>
            <if test="incomeNo != null">income_no = #{incomeNo},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="chargeAmount != null">charge_amount = #{chargeAmount},</if>
            <if test="purchaseAmount != null">purchase_amount = #{purchaseAmount},</if>
            <if test="balance != null">balance = #{balance},</if>
            <if test="score != null">score = #{score},</if>
            <if test="tradeDate != null">trade_date = #{tradeDate},</if>
            <if test="settlement != null">settlement = #{settlement},</if>
            <if test="companyIncome != null">company_income = #{companyIncome},</if>
            <if test="consultantIncome != null">consultant_income = #{consultantIncome},</if>
            <if test="productType != null">product_type = #{productType},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="consultantId != null">consultant_id = #{consultantId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where income_id = #{incomeId}
    </update>

    <delete id="deleteAppCustomerIncomeByIncomeId" parameterType="Long">
        delete from app_customer_income where income_id = #{incomeId}
    </delete>

    <delete id="deleteAppCustomerIncomeByIncomeIds" parameterType="String">
        delete from app_customer_income where income_id in 
        <foreach item="incomeId" collection="array" open="(" separator="," close=")">
            #{incomeId}
        </foreach>
    </delete>
</mapper>