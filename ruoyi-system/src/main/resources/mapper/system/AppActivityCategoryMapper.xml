<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AppActivityCategoryMapper">
    
    <resultMap type="AppActivityCategory" id="AppActivityCategoryResult">
        <result property="categoryId"    column="category_id"    />
        <result property="parentId"    column="parent_id"    />
        <result property="parentIds"    column="parent_ids"    />
        <result property="categoryName"    column="category_name"    />
        <result property="categoryIcon"    column="category_icon"    />
        <result property="remark"    column="remark"    />
        <result property="orderNum"    column="order_num"    />
        <result property="status"    column="status"    />
    </resultMap>

    <sql id="selectAppActivityCategoryVo">
        select category_id, parent_id, parent_ids, category_name, category_icon, remark, order_num, status from app_activity_category
    </sql>

    <select id="selectAppActivityCategoryList" parameterType="AppActivityCategory" resultMap="AppActivityCategoryResult">
        <include refid="selectAppActivityCategoryVo"/>
        <where>  
            <if test="parentId != null "> and parent_id = #{parentId}</if>
            <if test="parentIds != null  and parentIds != ''"> and parent_ids = #{parentIds}</if>
            <if test="categoryName != null  and categoryName != ''"> and category_name like concat('%', #{categoryName}, '%')</if>
            <if test="categoryIcon != null  and categoryIcon != ''"> and category_icon = #{categoryIcon}</if>
            <if test="orderNum != null "> and order_num = #{orderNum}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectAppActivityCategoryByCategoryId" parameterType="Long" resultMap="AppActivityCategoryResult">
        <include refid="selectAppActivityCategoryVo"/>
        where category_id = #{categoryId}
    </select>

    <insert id="insertAppActivityCategory" parameterType="AppActivityCategory" useGeneratedKeys="true" keyProperty="categoryId">
        insert into app_activity_category
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="parentId != null">parent_id,</if>
            <if test="parentIds != null">parent_ids,</if>
            <if test="categoryName != null and categoryName != ''">category_name,</if>
            <if test="categoryIcon != null">category_icon,</if>
            <if test="remark != null">remark,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="status != null and status != ''">status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="parentId != null">#{parentId},</if>
            <if test="parentIds != null">#{parentIds},</if>
            <if test="categoryName != null and categoryName != ''">#{categoryName},</if>
            <if test="categoryIcon != null">#{categoryIcon},</if>
            <if test="remark != null">#{remark},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="status != null and status != ''">#{status},</if>
         </trim>
    </insert>

    <update id="updateAppActivityCategory" parameterType="AppActivityCategory">
        update app_activity_category
        <trim prefix="SET" suffixOverrides=",">
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="parentIds != null">parent_ids = #{parentIds},</if>
            <if test="categoryName != null and categoryName != ''">category_name = #{categoryName},</if>
            <if test="categoryIcon != null">category_icon = #{categoryIcon},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="status != null and status != ''">status = #{status},</if>
        </trim>
        where category_id = #{categoryId}
    </update>

    <delete id="deleteAppActivityCategoryByCategoryId" parameterType="Long">
        delete from app_activity_category where category_id = #{categoryId}
    </delete>

    <delete id="deleteAppActivityCategoryByCategoryIds" parameterType="String">
        delete from app_activity_category where category_id in 
        <foreach item="categoryId" collection="array" open="(" separator="," close=")">
            #{categoryId}
        </foreach>
    </delete>
</mapper>