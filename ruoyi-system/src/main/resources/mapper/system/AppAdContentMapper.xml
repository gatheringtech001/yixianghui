<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AppAdContentMapper">
    
    <resultMap type="AppAdContent" id="AppAdContentResult">
        <result property="contentId"    column="content_id"    />
        <result property="positionId"    column="position_id"    />
        <result property="adName"    column="ad_name"    />
        <result property="description"    column="description"    />
        <result property="adImage"    column="ad_image"    />
        <result property="adContent"    column="ad_content"    />
        <result property="startTime"    column="start_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="linkUrl"    column="link_url"    />
        <result property="orderNum"    column="order_num"    />
        <result property="status"    column="status"    />
    </resultMap>

    <sql id="selectAppAdContentVo">
        select content_id, position_id, ad_name, description, ad_image, ad_content, start_time, end_time, link_url, order_num, status from app_ad_content
    </sql>

    <select id="selectAppAdContentList" parameterType="AppAdContent" resultMap="AppAdContentResult">
        <include refid="selectAppAdContentVo"/>
        <where>  
            <if test="positionId != null "> and position_id = #{positionId}</if>
            <if test="adName != null  and adName != ''"> and ad_name like concat('%', #{adName}, '%')</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="adImage != null  and adImage != ''"> and ad_image = #{adImage}</if>
            <if test="adContent != null  and adContent != ''"> and ad_content = #{adContent}</if>
            <if test="startTime != null "> and start_time = #{startTime}</if>
            <if test="endTime != null "> and end_time = #{endTime}</if>
            <if test="linkUrl != null  and linkUrl != ''"> and link_url = #{linkUrl}</if>
            <if test="orderNum != null "> and order_num = #{orderNum}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectAppAdContentByContentId" parameterType="Long" resultMap="AppAdContentResult">
        <include refid="selectAppAdContentVo"/>
        where content_id = #{contentId}
    </select>

    <insert id="insertAppAdContent" parameterType="AppAdContent" useGeneratedKeys="true" keyProperty="contentId">
        insert into app_ad_content
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="positionId != null">position_id,</if>
            <if test="adName != null and adName != ''">ad_name,</if>
            <if test="description != null">description,</if>
            <if test="adImage != null">ad_image,</if>
            <if test="adContent != null">ad_content,</if>
            <if test="startTime != null">start_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="linkUrl != null">link_url,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="status != null and status != ''">status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="positionId != null">#{positionId},</if>
            <if test="adName != null and adName != ''">#{adName},</if>
            <if test="description != null">#{description},</if>
            <if test="adImage != null">#{adImage},</if>
            <if test="adContent != null">#{adContent},</if>
            <if test="startTime != null">#{startTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="linkUrl != null">#{linkUrl},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="status != null and status != ''">#{status},</if>
         </trim>
    </insert>

    <update id="updateAppAdContent" parameterType="AppAdContent">
        update app_ad_content
        <trim prefix="SET" suffixOverrides=",">
            <if test="positionId != null">position_id = #{positionId},</if>
            <if test="adName != null and adName != ''">ad_name = #{adName},</if>
            <if test="description != null">description = #{description},</if>
            <if test="adImage != null">ad_image = #{adImage},</if>
            <if test="adContent != null">ad_content = #{adContent},</if>
            <if test="startTime != null">start_time = #{startTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="linkUrl != null">link_url = #{linkUrl},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="status != null and status != ''">status = #{status},</if>
        </trim>
        where content_id = #{contentId}
    </update>

    <delete id="deleteAppAdContentByContentId" parameterType="Long">
        delete from app_ad_content where content_id = #{contentId}
    </delete>

    <delete id="deleteAppAdContentByContentIds" parameterType="String">
        delete from app_ad_content where content_id in 
        <foreach item="contentId" collection="array" open="(" separator="," close=")">
            #{contentId}
        </foreach>
    </delete>

    <select id="selectAppAdContentListByPositionId" parameterType="Long" resultMap="AppAdContentResult">
        <include refid="selectAppAdContentVo"/>
        where position_id = #{positionId}
        order by order_num
    </select>
</mapper>