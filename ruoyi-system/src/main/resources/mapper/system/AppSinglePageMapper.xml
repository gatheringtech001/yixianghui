<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AppSinglePageMapper">
    
    <resultMap type="AppSinglePage" id="AppSinglePageResult">
        <result property="pageId"    column="page_id"    />
        <result property="pageName"    column="page_name"    />
        <result property="pageKey"    column="page_key"    />
        <result property="pageCover"    column="page_cover"    />
        <result property="description"    column="description"    />
        <result property="keywords"    column="keywords"    />
        <result property="isHot"    column="is_hot"    />
        <result property="content"    column="content"    />
        <result property="viewCount"    column="view_count"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="status"    column="status"    />
    </resultMap>

    <sql id="selectAppSinglePageVo">
        select page_id, page_name, page_key, page_cover, description, keywords, is_hot, content, view_count, create_time, update_time, status from app_single_page
    </sql>

    <select id="selectAppSinglePageList" parameterType="AppSinglePage" resultMap="AppSinglePageResult">
        <include refid="selectAppSinglePageVo"/>
        <where>  
            <if test="pageName != null  and pageName != ''"> and page_name like concat('%', #{pageName}, '%')</if>
            <if test="pageKey != null  and pageKey != ''"> and page_key = #{pageKey}</if>
            <if test="pageCover != null  and pageCover != ''"> and page_cover = #{pageCover}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="keywords != null  and keywords != ''"> and keywords = #{keywords}</if>
            <if test="isHot != null "> and is_hot = #{isHot}</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            <if test="viewCount != null "> and view_count = #{viewCount}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectAppSinglePageByPageId" parameterType="Long" resultMap="AppSinglePageResult">
        <include refid="selectAppSinglePageVo"/>
        where page_id = #{pageId}
    </select>

    <insert id="insertAppSinglePage" parameterType="AppSinglePage" useGeneratedKeys="true" keyProperty="pageId">
        insert into app_single_page
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="pageName != null and pageName != ''">page_name,</if>
            <if test="pageKey != null">page_key,</if>
            <if test="pageCover != null">page_cover,</if>
            <if test="description != null">description,</if>
            <if test="keywords != null">keywords,</if>
            <if test="isHot != null">is_hot,</if>
            <if test="content != null">content,</if>
            <if test="viewCount != null">view_count,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="status != null">status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="pageName != null and pageName != ''">#{pageName},</if>
            <if test="pageKey != null">#{pageKey},</if>
            <if test="pageCover != null">#{pageCover},</if>
            <if test="description != null">#{description},</if>
            <if test="keywords != null">#{keywords},</if>
            <if test="isHot != null">#{isHot},</if>
            <if test="content != null">#{content},</if>
            <if test="viewCount != null">#{viewCount},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="status != null">#{status},</if>
         </trim>
    </insert>

    <update id="updateAppSinglePage" parameterType="AppSinglePage">
        update app_single_page
        <trim prefix="SET" suffixOverrides=",">
            <if test="pageName != null and pageName != ''">page_name = #{pageName},</if>
            <if test="pageKey != null">page_key = #{pageKey},</if>
            <if test="pageCover != null">page_cover = #{pageCover},</if>
            <if test="description != null">description = #{description},</if>
            <if test="keywords != null">keywords = #{keywords},</if>
            <if test="isHot != null">is_hot = #{isHot},</if>
            <if test="content != null">content = #{content},</if>
            <if test="viewCount != null">view_count = #{viewCount},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where page_id = #{pageId}
    </update>

    <delete id="deleteAppSinglePageByPageId" parameterType="Long">
        delete from app_single_page where page_id = #{pageId}
    </delete>

    <delete id="deleteAppSinglePageByPageIds" parameterType="String">
        delete from app_single_page where page_id in 
        <foreach item="pageId" collection="array" open="(" separator="," close=")">
            #{pageId}
        </foreach>
    </delete>
</mapper>