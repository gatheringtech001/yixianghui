<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AppActivityMapper">
    
    <resultMap type="AppActivity" id="AppActivityResult">
        <result property="activityId"    column="activity_id"    />
        <result property="categoryId"    column="category_id"    />
        <result property="deptId"    column="dept_id"    />
        <result property="categoryIds"    column="category_ids"    />
        <result property="activityName"    column="activity_name"    />
        <result property="address"    column="address"    />
        <result property="activityCover"    column="activity_cover"    />
        <result property="description"    column="description"    />
        <result property="tags"    column="tags"    />
        <result property="isTop"    column="is_top"    />
        <result property="isHot"    column="is_hot"    />
        <result property="signCount"    column="sign_count"    />
        <result property="maxCount"    column="max_count"    />
        <result property="signEndTime"    column="sign_end_time"    />
        <result property="activityTime"    column="activity_time"    />
        <result property="activityEndTime"    column="activity_end_time"    />
        <result property="isFree"    column="is_free"    />
        <result property="price"    column="price"    />
        <result property="vipPrice"    column="vip_price"    />
        <result property="content"    column="content"    />
        <result property="viewCount"    column="view_count"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="status"    column="status"    />
    </resultMap>

    <sql id="selectAppActivityVo">
        select activity_id, category_id, dept_id, category_ids, activity_name, address, activity_cover, description, tags, is_top, is_hot, sign_count, max_count, sign_end_time, activity_time, activity_end_time, is_free, price, vip_price, content, view_count, create_time, update_time, status from app_activity
    </sql>

    <select id="selectAppActivityList" parameterType="AppActivity" resultMap="AppActivityResult">
        <include refid="selectAppActivityVo"/>
        <where>  
            <if test="categoryId != null "> and category_id = #{categoryId}</if>
            <if test="deptId != null"> and dept_id in(
                WITH RECURSIVE cte AS (
                SELECT dept_id, parent_id, dept_name
                FROM sys_dept
                WHERE dept_id = #{deptId}
                UNION ALL
                SELECT t.dept_id, t.parent_id, t.dept_name
                FROM sys_dept t
                INNER JOIN cte ON t.parent_id = cte.dept_id
                )
                SELECT dept_id FROM cte
                )</if>
            <if test="categoryIds != null  and categoryIds != ''"> and category_ids = #{categoryIds}</if>
            <if test="activityName != null  and activityName != ''"> and activity_name like concat('%', #{activityName}, '%')</if>
            <if test="address != null  and address != ''"> and address = #{address}</if>
            <if test="activityCover != null  and activityCover != ''"> and activity_cover = #{activityCover}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="tags != null  and tags != ''"> and tags = #{tags}</if>
            <if test="isTop != null "> and is_top = #{isTop}</if>
            <if test="isHot != null "> and is_hot = #{isHot}</if>
            <if test="signCount != null "> and sign_count = #{signCount}</if>
            <if test="maxCount != null "> and max_count = #{maxCount}</if>
            <if test="signEndTime != null "> and sign_end_time = #{signEndTime}</if>
            <if test="activityTime != null "> and activity_time = #{activityTime}</if>
            <if test="activityEndTime != null "> and activity_end_time = #{activityEndTime}</if>
            <if test="isFree != null "> and is_free = #{isFree}</if>
            <if test="price != null "> and price = #{price}</if>
            <if test="vipPrice != null "> and vip_price = #{vipPrice}</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            <if test="viewCount != null "> and view_count = #{viewCount}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <!-- active：未到结束时间（未填结束时间视为未结束）；ended：结束时间已过 -->
            <if test="signFilter != null and signFilter == 'ended'">
                and activity_end_time is not null and activity_end_time &lt; now()
            </if>
            <if test="signFilter != null and signFilter == 'active'">
                and (activity_end_time is null or activity_end_time &gt;= now())
            </if>
        </where>
    </select>
    
    <select id="selectAppActivityByActivityId" parameterType="Long" resultMap="AppActivityResult">
        <include refid="selectAppActivityVo"/>
        where activity_id = #{activityId}
    </select>

    <insert id="insertAppActivity" parameterType="AppActivity" useGeneratedKeys="true" keyProperty="activityId">
        insert into app_activity
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="categoryId != null">category_id,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="categoryIds != null">category_ids,</if>
            <if test="activityName != null and activityName != ''">activity_name,</if>
            <if test="address != null">address,</if>
            <if test="activityCover != null">activity_cover,</if>
            <if test="description != null">description,</if>
            <if test="tags != null">tags,</if>
            <if test="isTop != null">is_top,</if>
            <if test="isHot != null">is_hot,</if>
            <if test="signCount != null">sign_count,</if>
            <if test="maxCount != null">max_count,</if>
            <if test="signEndTime != null">sign_end_time,</if>
            <if test="activityTime != null">activity_time,</if>
            <if test="activityEndTime != null">activity_end_time,</if>
            <if test="isFree != null">is_free,</if>
            <if test="price != null">price,</if>
            <if test="vipPrice != null">vip_price,</if>
            <if test="content != null">content,</if>
            <if test="viewCount != null">view_count,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="status != null">status,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="categoryId != null">#{categoryId},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="categoryIds != null">#{categoryIds},</if>
            <if test="activityName != null and activityName != ''">#{activityName},</if>
            <if test="address != null">#{address},</if>
            <if test="activityCover != null">#{activityCover},</if>
            <if test="description != null">#{description},</if>
            <if test="tags != null">#{tags},</if>
            <if test="isTop != null">#{isTop},</if>
            <if test="isHot != null">#{isHot},</if>
            <if test="signCount != null">#{signCount},</if>
            <if test="maxCount != null">#{maxCount},</if>
            <if test="signEndTime != null">#{signEndTime},</if>
            <if test="activityTime != null">#{activityTime},</if>
            <if test="activityEndTime != null">#{activityEndTime},</if>
            <if test="isFree != null">#{isFree},</if>
            <if test="price != null">#{price},</if>
            <if test="vipPrice != null">#{vipPrice},</if>
            <if test="content != null">#{content},</if>
            <if test="viewCount != null">#{viewCount},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="status != null">#{status},</if>
         </trim>
    </insert>

    <update id="updateAppActivity" parameterType="AppActivity">
        update app_activity
        <trim prefix="SET" suffixOverrides=",">
            <if test="categoryId != null">category_id = #{categoryId},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="categoryIds != null">category_ids = #{categoryIds},</if>
            <if test="activityName != null and activityName != ''">activity_name = #{activityName},</if>
            <if test="address != null">address = #{address},</if>
            <if test="activityCover != null">activity_cover = #{activityCover},</if>
            <if test="description != null">description = #{description},</if>
            <if test="tags != null">tags = #{tags},</if>
            <if test="isTop != null">is_top = #{isTop},</if>
            <if test="isHot != null">is_hot = #{isHot},</if>
            <if test="signCount != null">sign_count = #{signCount},</if>
            <if test="maxCount != null">max_count = #{maxCount},</if>
            <if test="signEndTime != null">sign_end_time = #{signEndTime},</if>
            <if test="activityTime != null">activity_time = #{activityTime},</if>
            <if test="activityEndTime != null">activity_end_time = #{activityEndTime},</if>
            <if test="isFree != null">is_free = #{isFree},</if>
            <if test="price != null">price = #{price},</if>
            <if test="vipPrice != null">vip_price = #{vipPrice},</if>
            <if test="content != null">content = #{content},</if>
            <if test="viewCount != null">view_count = #{viewCount},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="status != null">status = #{status},</if>
        </trim>
        where activity_id = #{activityId}
    </update>

    <delete id="deleteAppActivityByActivityId" parameterType="Long">
        delete from app_activity where activity_id = #{activityId}
    </delete>

    <delete id="deleteAppActivityByActivityIds" parameterType="String">
        delete from app_activity where activity_id in 
        <foreach item="activityId" collection="array" open="(" separator="," close=")">
            #{activityId}
        </foreach>
    </delete>

    <update id="increaseSignCount">
        update app_activity
        set sign_count = CAST(IFNULL(NULLIF(sign_count, ''), 0) AS UNSIGNED) + #{count}
        where activity_id = #{activityId}
          and (
            max_count is null or max_count = '' or max_count = '0'
            or CAST(IFNULL(NULLIF(sign_count, ''), 0) AS UNSIGNED) + #{count} &lt;= CAST(max_count AS UNSIGNED)
          )
    </update>

    <update id="decreaseSignCount">
        update app_activity
        set sign_count = CAST(
            GREATEST(
                CAST(IFNULL(NULLIF(sign_count, ''), 0) AS SIGNED) - #{count},
                0
            ) AS CHAR
        )
        where activity_id = #{activityId}
    </update>
</mapper>
