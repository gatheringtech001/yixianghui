.page_view {
	margin: 0;
	padding: 0;
	width: 100vw;
	height: 100vh;
	overflow: hidden;
	
	.page_head_view {
		display: flex;
		
		.head_city_view {
			padding: 0 20rpx;
			display: flex;
			gap: 6rpx;
			
			.cuIcon-location {
				font-size: 36rpx;
			}
		}
		
		.head_search_view {
			display: flex;
			width: calc(100% - 180rpx);
			background-color: rgba(0, 0, 0, 0.15);
			padding: 16rpx 16rpx;
			border-radius: 20rpx;
			gap: 16rpx;
			overflow: hidden;
		}
	}

	.page_navbar_view {
		display: flex;
		width: 100%;
		background-color: #FFFFFF;
		padding: 12rpx 20rpx 16rpx;
		
		.navbar_item_view {
			width: 25%;
			gap: 6rpx;
			display: flex;
			flex-direction: column;
			align-items: center;
			
			image {
				width: 88rpx;
				height: 88rpx;
				border-radius: 16rpx;
			}
			
			.item_text_view {
				font-size: 24rpx;
				font-weight: bold;
			}
		}
		
		.navbar_select {
			color: #C30D24;
		}
	}

	.page_body_view {
		width: 100%;
		height: calc(100% - 500rpx);
		display: flex;
		
		.body_menu_view {
			width: 130rpx;
			height: 100%;
			overflow-y: auto;
			background-color: #FFF;
			
			.menu_item_view {
				width: 100%;
				height: 100rpx;
				display: flex;
				justify-content: center;
				align-items: center;
				font-size: 30rpx;
				font-weight: bold;
				color: #000000;
			}
			
			.menu_select {
				background: linear-gradient(to right, #FF7906, #FF413E);
				color: #fff;
				border-top-right-radius: 20rpx;
				border-bottom-right-radius: 20rpx;
			}
		}
	
		.body_goods_view {
			width: calc(100% - 130rpx);
			height: 100%;
			overflow-y: auto;
			padding: 20rpx;
			display: flex;
			flex-direction: column;
			gap: 30rpx;
			
			.goods_region_view {
				width: 100%;
				display: flex;
				flex-wrap: wrap;
				gap: 20rpx;
				
				.region_view {
					width: calc((100% / 3) - 14rpx);
					padding: 12rpx 0;
					text-align: center;
					border-radius: 10rpx;
					background-color: #FFFFFF;
					color: #000000;
					font-size: 34rpx;
					font-weight: bold;
				}
				
				.region_select {
					color: #FF5A23;
					background-color: #FFD9CD;
				}
			}
			
			.goods_item_view {
				width: 100%;
				background-color: #FFF;
				box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.1), 0 6rpx 6rpx rgba(0, 0, 0, 0.1);
				border-radius: 20rpx;
				
				image {
					width: 100%;
					height: 300rpx;
					border-top-left-radius: 20rpx;
					border-top-right-radius: 20rpx;
				}
				
				.item_content_view {
					padding: 20rpx;
					display: flex;
					flex-direction: column;
					gap: 20rpx;
					
					.content_title_view {
						color: #000000;
						font-size: 40rpx;
						font-weight: bold;
					}
					
					.content_desc_view {
						color: #999;
						font-size: 30rpx;
						font-weight: bold;
						overflow: hidden;
						display: -webkit-box;
						text-overflow: ellipsis;
						-webkit-box-orient: vertical;
						-webkit-line-clamp: 2;
					}
					
					.content_tag_view {
						display: flex;
						gap: 10rpx;
						flex-shrink: 0;
						
						.tag_view {
							padding: 4rpx 20rpx;
							font-size: 28rpx;
							color: #fff;
							border-radius: 10rpx;
							border-width: 1px;
							border-style: solid;
						}
					}
					
					.content_price_view {
						display: flex;
						align-items: center;
						
						.price_view {
							width: calc(100% - 180rpx);
							color: #000000;
							font-size: 30rpx;
							font-weight: bold;
							
							text {
								color: #FF0000;
								margin-right: 5rpx;
								
								text {
									font-size: 50rpx;
									margin-left: 5rpx;
								}
							}
						}
						
						.button_view {
							width: 180rpx;
							padding: 12rpx 0;
							border-radius: 20rpx;
							background: linear-gradient(to right, #FF7906, #FF413E);
							display: flex;
							justify-content: center;
							align-items: center;
							color: #FFFFFF;
							font-size: 30rpx;
							font-weight: bold;
						}
					}
				}
			}
		}
	}
}